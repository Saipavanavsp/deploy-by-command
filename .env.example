# Copy to .env (never commit .env). Or keep it outside the project and set ENV_FILE=/path/to/.env
MODE=mock                 # mock | aws
ALLOW_REAL_AWS=no         # must be "yes" AND MODE=aws to touch real AWS (two separate locks)
AWS_REGION=ap-south-1
AWS_PROFILE=deploy-by-command   # dedicated least-privilege IAM user (see README)
INSTANCE_TYPE=t3.micro
SSH_CIDR=                 # optional; empty = auto-detect your public IP + "/32". 0.0.0.0/0 is rejected.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=20000   # per Gemini request; on timeout the rules engine decides
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PROJECT_NAME=deploy-by-command
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Testing only
# MOCK_FAIL_STEP=deploy   # make the mock provider fail at a step (honest-failure demo)
# MOCK_DELAY_MS=700       # simulated step delay
